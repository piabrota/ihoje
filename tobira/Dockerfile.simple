FROM python:3.9-slim

WORKDIR /app

# Create the web directory and static directories
RUN mkdir -p /app/web/static/images

# Copy mock data and static files
COPY mock_data/index.html /app/web/
COPY mock_data/events.json /app/web/
COPY src/static /app/web/static

# Create Gate of Truth-themed SVG placeholders for images
RUN echo '<svg xmlns="http://www.w3.org/2000/svg" width="800" height="450" viewBox="0 0 800 450"><rect width="800" height="450" fill="#7000ff" /><text x="400" y="225" font-family="Arial" font-size="48" text-anchor="middle" fill="white">Shinri no Tobira 1</text></svg>' > /app/web/static/images/event1.svg
RUN echo '<svg xmlns="http://www.w3.org/2000/svg" width="800" height="450" viewBox="0 0 800 450"><rect width="800" height="450" fill="#5000d0" /><text x="400" y="225" font-family="Arial" font-size="48" text-anchor="middle" fill="white">Shinri no Tobira 2</text></svg>' > /app/web/static/images/event2.svg
RUN echo '<svg xmlns="http://www.w3.org/2000/svg" width="800" height="450" viewBox="0 0 800 450"><rect width="800" height="450" fill="#4000a0" /><text x="400" y="225" font-family="Arial" font-size="48" text-anchor="middle" fill="white">Shinri no Tobira 3</text></svg>' > /app/web/static/images/event3.svg
RUN echo '<svg xmlns="http://www.w3.org/2000/svg" width="800" height="450" viewBox="0 0 800 450"><rect width="800" height="450" fill="#300080" /><text x="400" y="225" font-family="Arial" font-size="48" text-anchor="middle" fill="white">Shinri no Tobira 4</text></svg>' > /app/web/static/images/event4.svg

# Create .htaccess file for MIME types
RUN echo "AddType application/wasm .wasm" > /app/web/.htaccess

EXPOSE 8080

# Create a custom SPA server file that properly handles WASM files
RUN echo '#!/usr/bin/env python3\n\
import http.server\n\
import socketserver\n\
import os\n\
\n\
class SPAHandler(http.server.SimpleHTTPRequestHandler):\n\
    # Add MIME types for WebAssembly\n\
    extensions_map = {\n\
        **http.server.SimpleHTTPRequestHandler.extensions_map,\n\
        ".wasm": "application/wasm",\n\
    }\n\
    \n\
    def end_headers(self):\n\
        # Add CORS headers to allow fetch requests\n\
        self.send_header("Access-Control-Allow-Origin", "*")\n\
        # Explicitly set WASM MIME type for all .wasm files\n\
        if self.path.endswith(".wasm"):\n\
            self.send_header("Content-Type", "application/wasm")\n\
        http.server.SimpleHTTPRequestHandler.end_headers(self)\n\
    \n\
    def do_GET(self):\n\
        print(f"GET request for: {self.path}")\n\
        # For WASM files, add special handling\n\
        if self.path.endswith(".wasm"):\n\
            print(f"  -> Serving WASM file with application/wasm MIME type")\n\
            # Ensure specific content type for .wasm files\n\
            filepath = os.path.join(os.getcwd(), self.path.lstrip("/"))\n\
            if os.path.exists(filepath):\n\
                with open(filepath, "rb") as f:\n\
                    content = f.read()\n\
                    self.send_response(200)\n\
                    self.send_header("Content-Type", "application/wasm")\n\
                    self.send_header("Content-Length", str(len(content)))\n\
                    self.end_headers()\n\
                    self.wfile.write(content)\n\
                    return\n\
        \n\
        # Handle SPA routing - serve index.html for non-existent paths\n\
        if not os.path.exists(os.path.join("/app/web", self.path.lstrip("/"))):\n\
            self.path = "/index.html"\n\
        return http.server.SimpleHTTPRequestHandler.do_GET(self)\n\
\n\
handler = SPAHandler\n\
port = 8080\n\
\n\
print(f"Starting SPA server on port {port}")\n\
with socketserver.TCPServer(("", port), handler) as httpd:\n\
    os.chdir("/app/web")\n\
    print(f"Serving SPA at http://localhost:{port}")\n\
    print(f"WebAssembly MIME type: application/wasm")\n\
    httpd.serve_forever()' > /app/spa_server.py

# Make the server script executable
RUN chmod +x /app/spa_server.py

CMD ["python", "/app/spa_server.py"]