FROM python:3.9-slim

WORKDIR /app

# Create the web directory and static directories
RUN mkdir -p /app/web/static/images

# Copy mock data and static files
COPY mock_data/index.html /app/web/
COPY mock_data/events.json /app/web/
COPY src/static /app/web/static

# Create Gate of Truth-themed SVG placeholders for images
RUN echo '<svg xmlns="http://www.w3.org/2000/svg" width="800" height="450" viewBox="0 0 800 450"><rect width="800" height="450" fill="#7000ff" /><text x="400" y="225" font-family="Arial" font-size="48" text-anchor="middle" fill="white">Shinri no Tobira 1</text></svg>' > /app/web/static/images/event1.svg
RUN echo '<svg xmlns="http://www.w3.org/2000/svg" width="800" height="450" viewBox="0 0 800 450"><rect width="800" height="450" fill="#5000d0" /><text x="400" y="225" font-family="Arial" font-size="48" text-anchor="middle" fill="white">Shinri no Tobira 2</text></svg>' > /app/web/static/images/event2.svg
RUN echo '<svg xmlns="http://www.w3.org/2000/svg" width="800" height="450" viewBox="0 0 800 450"><rect width="800" height="450" fill="#4000a0" /><text x="400" y="225" font-family="Arial" font-size="48" text-anchor="middle" fill="white">Shinri no Tobira 3</text></svg>' > /app/web/static/images/event3.svg
RUN echo '<svg xmlns="http://www.w3.org/2000/svg" width="800" height="450" viewBox="0 0 800 450"><rect width="800" height="450" fill="#300080" /><text x="400" y="225" font-family="Arial" font-size="48" text-anchor="middle" fill="white">Shinri no Tobira 4</text></svg>' > /app/web/static/images/event4.svg

# Create .htaccess file for MIME types
RUN echo "AddType application/wasm .wasm" > /app/web/.htaccess

# Copy our enhanced security server
COPY spa_server.py /app/

# Make log directories
RUN mkdir -p /app/logs

# Create directories for authentication
RUN mkdir -p /app/web/auth

# Set development environment variable
ENV IHOJE_ENVIRONMENT=development

# Add debugging tools
RUN apt-get update && \
    apt-get install -y curl net-tools netcat-openbsd procps iproute2 iputils-ping && \
    rm -rf /var/lib/apt/lists/*

# Add debug script
RUN echo '#!/bin/bash\nps -ef\nnetstat -tuln\ncurl -v http://localhost:8080\necho "Server logs:"\ncat /app/logs/*.log 2>/dev/null || echo "No log files found"' > /app/debug.sh && \
    chmod +x /app/debug.sh

EXPOSE 8080

# Make the server script executable
RUN chmod +x /app/spa_server.py

CMD ["python", "/app/spa_server.py", "8080", "/app/web"]