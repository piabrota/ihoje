# Firecrawl API credentials
FIRECRAWL_API_KEY=your_api_key_here

# Provider selection (pikachu or charmander)
# pikachu = Provider 1
# charmander = Provider 2
PROVIDER=pikachu

# City configuration (FL, RJ, or SP)
CITY=FL

# Provider URLs (provider specific)
# For production, use the appropriate provider URLs
PIKACHU_API_URL=https://example.com/events
CHARMANDER_API_URL=https://example.com/events

# Maximum number of events to process (reduces API usage)
MAX_EVENTS=10

# Date range for filtering events (YYYY-MM-DD format)
# START_DATE=2025-03-22
# END_DATE=2025-03-29

# Database settings
# Export format: postgres, gcp, or pg_with_gcp_fallback
EXPORT_FORMAT=pg_with_gcp_fallback

# PostgreSQL connection (required when EXPORT_FORMAT=postgres or pg_with_gcp_fallback)
#PG_HOST=localhost
#PG_PORT=5432
#PG_USER=postgres
#PG_PASSWORD=postgres
#PG_DATABASE=events

# GCP Storage settings (required when EXPORT_FORMAT=gcp or pg_with_gcp_fallback)
#GCP_BUCKET_NAME=your-events-bucket
#GCP_PROJECT_ID=your-gcp-project-id
#GCP_BASE_PATH=events
#GCP_API_KEY=your-gcp-api-key

# API keys for MCP tools
# Required for Brave Search API MCP tool - Get a key at https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# API keys for DeepThink MCP (implementation planning)
# At least one of these is required to use DeepThink
#DEEPSEEK_API_KEY=your_deepseek_api_key_here
#OPENAI_API_KEY=your_openai_api_key_here
#GEMINI_API_KEY=your_gemini_api_key_here
#DEEPTHINK_MCP_PORT=3790